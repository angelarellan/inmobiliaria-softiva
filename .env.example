# Copiá este archivo como .env.local y completá los valores.
# En Vercel: Settings → Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca en el cliente ni en el código
SUPABASE_SECRET_KEY=

# URL pública de la web, sin barra final (ej. https://inmobiliariaaura.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Número de WhatsApp en formato internacional, solo dígitos (ej. 5491100000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Usuario demo del panel (para interesados)
DEMO_ADMIN_USER=
DEMO_ADMIN_PASSWORD=

# Usuario dueño del panel (acceso completo). Si quedan vacías, ese ingreso se deshabilita.
OWNER_ADMIN_USER=
OWNER_ADMIN_PASSWORD=

# Valores al azar y largos (mínimo 32 caracteres). Ej: openssl rand -base64 36
SESSION_SECRET=
CRON_SECRET=
